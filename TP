
.data
	msg1:  .asciiz "Digite o primeiro valor:\n"
	msg2: .asciiz "Digite o segundo valor:\n"
	msg_seta: .asciiz "-->"
	msg_erro: .asciiz "Os valores devem ser estritamente positivos!\n"
	msg_mmc: .asciiz "O mmc é igual à: "
	msg_mdc: .asciiz "O mdc é igual à: "

.text
.globl main
    
main:
    # Primeiro scanf
    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 4
    la $a0, msg_seta
    syscall

    li $v0, 5
    syscall
    move $s0, $v0       # a

    # Segundo scanf
    li $v0, 4
    la $a0, msg2
    syscall

    li $v0, 4
    la $a0, msg_seta
    syscall

    li $v0, 5
    syscall
    move $s1, $v0       # b
    
    #verificação entrada de dados
    blez $s0, valores_invalidos
    blez $s1, valores_invalidos
    
    # puxa a função MMC
    move $a0, $s0
    move $a1, $s1
    jal mmc
    move $s2, $v0
    
    #puxa a função MDC
    move $a0, $s0
    move $a1, $s1
    jal mdc
    move $s3, $v0
    
    #Aqui os calculos já estão prontos
    
    #printf 1
    li $v0, 4
    la $a0, msg_mmc
    syscall
    
    #printf 2
    li $v0, 1
    move $a0, $s2
    syscall
    
    #printf 3
     li $v0, 4
    la $a0, msg_mdc
    syscall
    
    #printf 4
    li $v0, 1
    move $a0, $s3
    syscall
    
    j encerrar
    
valores_invalidos:
    li $v0, 4
    la $a0, msg_erro
    syscall

    j encerrar

mdc:
    #coloca os valores no escopo local
    move $t0, $a0
    move $t1, $a1
    
while:
    # (b  !=  0)
    beq $t1, $zero, r_mdc

    # resto = a % b
    div $t0, $t1
    mfhi $t2            # HI é o resto

    # a == b;
    move $t0, $t1

    # b == resto;
    move $t1, $t2

    j while
    
r_mdc:
    #return mdc;
    move $v0, $t0
    jr $ra
   
mmc:
    # coloca os valores no escopo local
     move $t3, $a0
     move $t4, $a1

    # guarda o endereço de retorno na pilha
     addi $sp, $sp, -4
     sw $ra, 0($sp)

    # puxa a função mdc
    jal mdc

    # a * b
    mult $t3, $t4
    mflo $t5

    # (a * b) / mdc(a,b)
    div $t5, $v0
    mflo $v0

    # recupera o endereço de retorno
    lw $ra, 0($sp)
    addi $sp, $sp, 4

    # retorna ao main
    jr $ra

encerrar:
    # return 0
    li $v0, 10
    syscall
